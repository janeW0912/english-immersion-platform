# 新版官方 SDK（@google/genai）默认读取 GEMINI_API_KEY，与 Python google-genai 一致
# https://ai.google.dev/gemini-api/docs/quickstart
GEMINI_API_KEY=

# 本机直连 Google 失败（fetch failed）时，填本地 HTTP 代理（示例为 Clash 常见端口）
# GEMINI_HTTP_PROXY=http://127.0.0.1:7890

# 若你仍用旧变量名，也可填（二选一即可）
# GOOGLE_GENERATIVE_AI_API_KEY=

# 模型 ID（默认 gemini-3-flash-preview，与文档示例一致）
GEMINI_MODEL=gemini-3-flash-preview

# 未配置 Gemini 时回退 OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 沉浸页 RSS：逗号或换行分隔多个 feed URL；不设则用内置 BBC / Guardian / TED YouTube Atom
# IMMERSION_RSS_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.theguardian.com/world/rss
# 国内拉 RSS 常超时：单独指定 RSS 代理（或与下方 GEMINI_HTTP_PROXY 相同）
# RSS_HTTP_PROXY=http://127.0.0.1:7890
# 单次请求超时毫秒（默认 45000）
# IMMERSION_RSS_TIMEOUT_MS=60000

# RSS 每条卡片保存的正文最大字符（默认 500000）
# IMMERSION_RSS_BODY_MAX_CHARS=500000

# 「拉取网页全文」单次超时毫秒（默认 90000）
# IMMERSION_ARTICLE_TIMEOUT_MS=90000

# 播客：整集下载上限（字节，默认 128000000 ≈ 128MB，最高约 256MB）
# IMMERSION_PODCAST_AUDIO_MAX_TOTAL_BYTES=160000000
# 单段送 Gemini 上限（字节，默认 32000000 ≈ 32MB）；超大 MP3 会在此阈值按帧自动切段转写
# IMMERSION_PODCAST_AUDIO_MAX_BYTES=48000000
# 下载播客音频超时毫秒（默认 120000）
# IMMERSION_PODCAST_AUDIO_TIMEOUT_MS=120000
# 音频转写所用 Gemini 模型（默认 gemini-2.0-flash；也可设专用模型）
# GEMINI_PODCAST_MODEL=gemini-2.0-flash
